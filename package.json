{
  "name": "@pndspnds/dsh-airplane-battle",
  "version": "1.1.1",
  "description": "A 60fps character-cell vertical shooter that covers the conversation area, then steps aside.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ascii",
    "shooter",
    "canvas",
    "game"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PNDSpnds/dsh-airplane-battle.git"
  },
  "homepage": "https://github.com/PNDSpnds/dsh-airplane-battle#readme",
  "bugs": {
    "url": "https://github.com/PNDSpnds/dsh-airplane-battle/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets",
    "icon.svg",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
